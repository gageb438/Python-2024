def pet_add(pet_dict):
    # pet_add recieves an argument for a dictionary of pets
    # it asks the user for a pet and attributes
    # it then adds it to the dictionary
    
    # initalize variables
    bad = True
    name = input("Enter your pets name: ")
    pet_type = input("Enter the type of pet you have: ")
    while bad == True:
        try:
          age = int(input("Enter the age of your pet: "))
          bad = False
        except:
          bad = True
    
    # make a new pet object
    new_pet = pet.Pets(name, pet_type, age)
    
    # add it to the dictionary
    pet_dict[new_pet.get_name()] = new_pet
    # return the dictionary
    return pet_dict

def pet_modify(pet_dict):
    # pet_modify accepts an argument for a dictionary of pets
    # it asks if the user wants to modify a pet
    # and validates it is there then modifies it
    # it returns the modified dictionary
    
    # ask for the pets name
    wanted_pet = input("What is the name of the pet you want to modify: ")
    
    # if its not in the dictionary already
    while wanted_pet not in pet_dict:
